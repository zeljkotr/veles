{% extends "base.html" %}

{% block title %}
VELES Terminal
{% endblock %}

{% block application %}
TERMINAL
{% endblock %}

{% block extra_css %}

<style>

.terminal-page {
    display: flex;
    flex-direction: column;
    height: calc(100vh - 82px);
    min-height: 500px;
}

.terminal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px;
    border-bottom: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.015);
}

.terminal-title {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    color: var(--text);
}

.terminal-status {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    color: var(--muted);
}

.terminal-status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 8px rgba(80, 200, 120, 0.6);
}

.terminal-container {
    flex: 1;
    min-height: 0;
    padding: 14px;
    background: #050505;
    overflow: hidden;
}

#veles-terminal {
    width: 100%;
    height: 100%;
    overflow: auto;
    box-sizing: border-box;
    padding: 16px;
    background: #050505;
    border: 1px solid var(--border);
    border-radius: 8px;
    color: #e5e7eb;
    font-family:
        "DejaVu Sans Mono",
        "Liberation Mono",
        monospace;
    font-size: 14px;
    line-height: 1.45;
    white-space: pre-wrap;
    word-break: break-all;
    outline: none;
    cursor: text;
    user-select: text;
    -webkit-user-select: text;
}

.terminal-input {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
}

.terminal-disconnected {
    color: #f87171;
}

</style>

{% endblock %}


{% block content %}

<div class="terminal-page">

    <div class="terminal-header">

        <div class="terminal-title">
            VELES TERMINAL
        </div>

        <div class="terminal-status">

            <span
                id="terminal-status-dot"
                class="terminal-status-dot"
            ></span>

            <span id="terminal-status">
                CONNECTING
            </span>

        </div>

    </div>


    <div class="terminal-container">

        <div
            id="veles-terminal"
            tabindex="0"
            aria-label="VELES Terminal"
        ></div>

        <textarea
            id="terminal-input"
            class="terminal-input"
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
            spellcheck="false"
        ></textarea>

    </div>

</div>

{% endblock %}


{% block extra_js %}

<script>

(function () {

    "use strict";


    const terminal =
        document.getElementById(
            "veles-terminal"
        );


    const input =
        document.getElementById(
            "terminal-input"
        );


    const status =
        document.getElementById(
            "terminal-status"
        );


    let socket = null;


    function setStatus(
        text,
        connected
    ) {

        status.textContent =
            text;

        if (connected) {

            status.classList.remove(
                "terminal-disconnected"
            );

        } else {

            status.classList.add(
                "terminal-disconnected"
            );
        }
    }


    function writeOutput(
        text
    ) {

        terminal.textContent +=
            text;

        terminal.scrollTop =
            terminal.scrollHeight;
    }


    function sendData(
        data
    ) {

        if (
            !socket ||
            socket.readyState !== WebSocket.OPEN ||
            !data
        ) {

            return;
        }

        socket.send(
            data
        );
    }


    function focusTerminal() {

        terminal.focus();

    }


    function connect() {

        const protocol =
            window.location.protocol === "https:"
                ? "wss:"
                : "ws:";


        const url =
            protocol +
            "//" +
            window.location.host +
            "/ws/terminal";


        setStatus(
            "CONNECTING",
            false
        );


        socket =
            new WebSocket(
                url
            );


        socket.onopen =
            function () {

                setStatus(
                    "ONLINE",
                    true
                );

                focusTerminal();

                sendResize();
            };


        socket.onmessage =
            function (event) {

                writeOutput(
                    event.data
                );
            };


        socket.onerror =
            function () {

                setStatus(
                    "ERROR",
                    false
                );
            };


        socket.onclose =
            function () {

                setStatus(
                    "DISCONNECTED",
                    false
                );
            };
    }


    function sendResize() {

        if (
            !socket ||
            socket.readyState !== WebSocket.OPEN
        ) {

            return;
        }


        const rect =
            terminal.getBoundingClientRect();


        const cols =
            Math.max(
                40,
                Math.floor(
                    rect.width / 8
                )
            );


        const rows =
            Math.max(
                10,
                Math.floor(
                    rect.height / 20
                )
            );


        socket.send(
            "__VELES_RESIZE__:" +
            rows +
            ":" +
            cols
        );
    }


    terminal.addEventListener(
        "click",
        function () {

            focusTerminal();

        }
    );


    terminal.addEventListener(
        "keydown",
        function (event) {

            if (
                !socket ||
                socket.readyState !== WebSocket.OPEN
            ) {

                return;
            }


            /*
             * COPY
             *
             * Ctrl+Shift+C is explicit terminal copy.
             */

            if (
                event.ctrlKey &&
                event.shiftKey &&
                event.key.toLowerCase() === "c"
            ) {

                const selection =
                    window.getSelection();

                const text =
                    selection
                        ? selection.toString()
                        : "";

                if (text) {

                    navigator.clipboard
                        .writeText(
                            text
                        )
                        .catch(
                            function () {}
                        );
                }

                event.preventDefault();

                return;
            }


            /*
             * PASTE
             *
             * Ctrl+V is handled by the paste
             * event below.
             */

            if (
                event.ctrlKey &&
                event.key.toLowerCase() === "v"
            ) {

                event.preventDefault();

                navigator.clipboard
                    .readText()
                    .then(
                        function (text) {

                            if (text) {

                                sendData(
                                    text
                                );
                            }
                        }
                    )
                    .catch(
                        function () {}
                    );

                return;
            }


            /*
             * CTRL+C
             *
             * Send SIGINT to the shell.
             */

            if (
                event.ctrlKey &&
                !event.shiftKey &&
                event.key.toLowerCase() === "c"
            ) {

                const selection =
                    window.getSelection();

                if (
                    selection &&
                    !selection.isCollapsed
                ) {

                    navigator.clipboard
                        .writeText(
                            selection.toString()
                        )
                        .catch(
                            function () {}
                        );

                    event.preventDefault();

                    return;
                }


                sendData(
                    "\x03"
                );

                event.preventDefault();

                return;
            }


            /*
             * CTRL+D
             */

            if (
                event.ctrlKey &&
                event.key.toLowerCase() === "d"
            ) {

                sendData(
                    "\x04"
                );

                event.preventDefault();

                return;
            }


            /*
             * CTRL+L
             */

            if (
                event.ctrlKey &&
                event.key.toLowerCase() === "l"
            ) {

                sendData(
                    "\x0c"
                );

                event.preventDefault();

                return;
            }


            /*
             * ENTER
             */

            if (
                event.key === "Enter"
            ) {

                sendData(
                    "\r"
                );

                event.preventDefault();

                return;
            }


            /*
             * BACKSPACE
             */

            if (
                event.key === "Backspace"
            ) {

                sendData(
                    "\x7f"
                );

                event.preventDefault();

                return;
            }


            /*
             * TAB
             */

            if (
                event.key === "Tab"
            ) {

                sendData(
                    "\t"
                );

                event.preventDefault();

                return;
            }


            /*
             * ARROW KEYS
             */

            if (
                event.key === "ArrowUp"
            ) {

                sendData(
                    "\x1b[A"
                );

                event.preventDefault();

                return;
            }


            if (
                event.key === "ArrowDown"
            ) {

                sendData(
                    "\x1b[B"
                );

                event.preventDefault();

                return;
            }


            if (
                event.key === "ArrowRight"
            ) {

                sendData(
                    "\x1b[C"
                );

                event.preventDefault();

                return;
            }


            if (
                event.key === "ArrowLeft"
            ) {

                sendData(
                    "\x1b[D"
                );

                event.preventDefault();

                return;
            }


            /*
             * NORMAL CHARACTER INPUT
             */

            if (
                event.key.length === 1 &&
                !event.ctrlKey &&
                !event.altKey &&
                !event.metaKey
            ) {

                sendData(
                    event.key
                );

                event.preventDefault();

            }

        }
    );


    /*
     * PASTE EVENT
     *
     * Handles:
     *
     * Ctrl+V
     * browser paste
     * context-menu paste
     * middle-click paste where supported
     */

    terminal.addEventListener(
        "paste",
        function (event) {

            event.preventDefault();


            const clipboard =
                event.clipboardData;


            if (!clipboard) {

                return;
            }


            const text =
                clipboard.getData(
                    "text/plain"
                );


            if (text) {

                sendData(
                    text
                );
            }

        }
    );


    /*
     * COPY EVENT
     *
     * Allow normal browser selection
     * to copy terminal output.
     */

    terminal.addEventListener(
        "copy",
        function (event) {

            const selection =
                window.getSelection();


            if (
                !selection ||
                selection.isCollapsed
            ) {

                return;
            }


            const text =
                selection.toString();


            if (!text) {

                return;
            }


            event.clipboardData.setData(
                "text/plain",
                text
            );


            event.preventDefault();

        }
    );


    /*
     * SHIFT+INSERT
     *
     * Traditional Linux terminal paste.
     */

    terminal.addEventListener(
        "keydown",
        function (event) {

            if (
                event.shiftKey &&
                event.key === "Insert"
            ) {

                event.preventDefault();


                navigator.clipboard
                    .readText()
                    .then(
                        function (text) {

                            if (text) {

                                sendData(
                                    text
                                );
                            }
                        }
                    )
                    .catch(
                        function () {}
                    );
            }

        }
    );


    window.addEventListener(
        "resize",
        sendResize
    );


    connect();

})();

</script>

{% endblock %}
