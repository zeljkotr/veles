<!DOCTYPE html>
<html lang="sr">

<head>

<meta charset="UTF-8">

<meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
>


<title>
{% block title %}
Veles Operating System
{% endblock %}
</title>


<!-- =====================================================
     VELES FAVICON
     ===================================================== -->

<link
    rel="icon"
    type="image/svg+xml"
    href="{{ url_for(
        'static',
        filename='images/favicon.svg',
        v='1'
    ) }}"
>

<link
    rel="shortcut icon"
    href="{{ url_for(
        'static',
        filename='images/favicon.svg',
        v='1'
    ) }}"
>


<!-- =====================================================
     GLOBAL CSS
     ===================================================== -->

<link
    rel="stylesheet"
    href="{{ url_for(
        'static',
        filename='css/veles.css',
        v='4'
    ) }}"
>


<link
    rel="stylesheet"
    href="{{ url_for(
        'static',
        filename='css/dashboard.css',
        v='3'
    ) }}"
>


<link
    rel="stylesheet"
    href="{{ url_for(
        'static',
        filename='css/logs.css',
        v='2'
    ) }}"
>


<link
    rel="stylesheet"
    href="{{ url_for(
        'static',
        filename='css/system.css',
        v='2'
    ) }}"
>


{% block extra_css %}
{% endblock %}

<style>
    /* POWER MENU - VELES STYLE */
    .power-control {
        position: relative;
        display: inline-block;
        margin-left: 12px;
    }

    .power-button {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        background: transparent;
        border: 1px solid var(--border);
        border-radius: 8px;
        color: var(--muted);
        font-size: 18px;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .power-button:hover {
        background: rgba(217, 164, 65, 0.08);
        border-color: var(--gold);
        color: var(--gold);
    }

    .power-menu {
        position: absolute;
        top: calc(100% + 8px);
        right: 0;
        min-width: 180px;
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 6px;
        box-shadow: 0 12px 48px rgba(0, 0, 0, 0.7);
        opacity: 0;
        visibility: hidden;
        transform: translateY(-4px);
        transition: all 0.2s ease;
        z-index: 1000;
    }

    .power-menu[aria-hidden="false"] {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }

    .power-menu-title {
        padding: 6px 12px 4px 12px;
        color: var(--muted);
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 1.5px;
        border-bottom: 1px solid var(--border);
        margin-bottom: 4px;
    }

    .power-menu-item {
        display: flex;
        align-items: center;
        gap: 10px;
        width: 100%;
        padding: 8px 12px;
        background: transparent;
        border: none;
        border-radius: 6px;
        color: var(--text);
        font-family: inherit;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s ease;
    }

    .power-menu-item:hover {
        background: rgba(255, 255, 255, 0.04);
    }

    .power-menu-item .power-menu-icon {
        font-size: 16px;
        width: 20px;
        text-align: center;
        color: var(--muted);
    }

    .power-reboot:hover {
        color: var(--green);
    }

    .power-reboot:hover .power-menu-icon {
        color: var(--green);
    }

    .power-shutdown:hover {
        color: #f87171;
    }

    .power-shutdown:hover .power-menu-icon {
        color: #f87171;
    }
</style>

</head>


<body>


<div class="app-layout">


<!-- =====================================================
     VELES OS SIDEBAR
     ===================================================== -->

<aside class="sidebar">


    <!-- OS BRAND -->

    <div class="sidebar-brand">

        <div class="sidebar-brand-mark">
            V
        </div>

        <div class="sidebar-brand-name">
            VELES
        </div>

        <div class="sidebar-brand-os">
            OPERATING SYSTEM
        </div>

    </div>


    <!-- NAVIGATION -->

    <nav class="main-menu">


        <!-- WORKSPACE -->

        <div class="main-menu-section">

            <div class="main-menu-section-title">
                WORKSPACE
            </div>


            <a
                href="{{ url_for('dashboard_view') }}"
                class="{% if request.endpoint == 'dashboard_view' %}active{% endif %}"
            >

                <span class="main-menu-icon">
                    ◉
                </span>

                <span class="main-menu-label">
                    Overview
                </span>

            </a>

        </div>


        <!-- OPERATIONS -->

        <div class="main-menu-section">

            <div class="main-menu-section-title">
                OPERATIONS
            </div>


            <a
                href="{{ url_for('discovery_page') }}"
                class="{% if request.endpoint == 'discovery_page' %}active{% endif %}"
            >

                <span class="main-menu-icon">
                    ◈
                </span>

                <span class="main-menu-label">
                    Discovery
                </span>

            </a>


            <a
                href="{{ url_for('system_view') }}"
                class="{% if request.endpoint == 'system_view' %}active{% endif %}"
            >

                <span class="main-menu-icon">
                    ▣
                </span>

                <span class="main-menu-label">
                    System
                </span>

            </a>


            <a
                href="{{ url_for('logs_view') }}"
                class="{% if request.endpoint == 'logs_view' %}active{% endif %}"
            >

                <span class="main-menu-icon">
                    ◇
                </span>

                <span class="main-menu-label">
                    Events
                </span>

            </a>


            <a
                href="{{ url_for('terminal') }}"
                class="{% if request.endpoint == 'terminal' %}active{% endif %}"
            >

                <span class="main-menu-icon">
                    ▸_
                </span>

                <span class="main-menu-label">
                    Terminal
                </span>

            </a>

        </div>


        <!-- INTELLIGENCE -->

        <div class="main-menu-section">

            <div class="main-menu-section-title">
                INTELLIGENCE
            </div>


            <a
                href="{{ url_for('chat') }}"
                class="{% if request.endpoint == 'chat' %}active{% endif %}"
            >

                <span class="main-menu-icon">
                    ✦
                </span>

                <span class="main-menu-label">
                    AI
                </span>

            </a>


            <a
                href="{{ url_for('memory_view') }}"
                class="{% if request.endpoint == 'memory_view' %}active{% endif %}"
            >

                <span class="main-menu-icon">
                    ◎
                </span>

                <span class="main-menu-label">
                    Memory
                </span>

            </a>

        </div>


    </nav>


    <!-- SIDEBAR FOOTER -->

    <div class="sidebar-footer">

        <div class="sidebar-footer-line"></div>

        <div class="sidebar-footer-label">
            VELES OS
        </div>

        <div class="sidebar-footer-status">
            LOCAL SYSTEM
        </div>

    </div>


</aside>


<!-- =====================================================
     MAIN OS AREA
     ===================================================== -->

<section class="main-area">


    <!-- =================================================
         SYSTEM BAR
         ================================================= -->

    <header class="top-header">


        <div class="top-header-left">

            <div class="top-header-title">
                VELES OPERATING SYSTEM
            </div>

            <div class="top-header-divider"></div>

            <div class="top-header-application">
                {% block application %}
                APPLICATION
                {% endblock %}
            </div>

        </div>


        <div class="top-header-right">


            <div class="system-status">

                <span class="system-status-dot"></span>

                <span class="system-status-text">
                    ONLINE
                </span>

            </div>


            <div class="system-status-separator"></div>


            <div class="system-status-secondary">
                LOCAL
            </div>


            <!-- POWER -->

            <div class="power-control">

                <button
                    type="button"
                    class="power-button"
                    id="power-button"
                    aria-label="Power"
                    aria-expanded="false"
                >
                    ⏻
                </button>


                <div
                    class="power-menu"
                    id="power-menu"
                    aria-hidden="true"
                >

                    <div class="power-menu-title">
                        SYSTEM POWER
                    </div>


                    <button
                        type="button"
                        class="power-menu-item power-reboot"
                        id="power-reboot"
                        onclick="if(confirm('Restart?')){fetch('/system/reboot',{method:'POST'}).then(()=>alert('Restarting...')).catch(()=>alert('Error'))}"
                    >
                        <span class="power-menu-icon">
                            ↻
                        </span>

                        <span>
                            REBOOT
                        </span>
                    </button>


                    <button
                        type="button"
                        class="power-menu-item power-shutdown"
                        id="power-shutdown"
                        onclick="if(confirm('Shutdown?')){fetch('/system/shutdown',{method:'POST'}).then(()=>alert('Shutting down...')).catch(()=>alert('Error'))}"
                    >
                        <span class="power-menu-icon">
                            ⏻
                        </span>

                        <span>
                            SHUTDOWN
                        </span>
                    </button>

                </div>

            </div>


        </div>


    </header>


    <!-- =================================================
         APPLICATION CONTENT
         ================================================= -->

    <main class="page-container">

        {% block content %}
        {% endblock %}

    </main>


</section>


</div>


<!-- =====================================================
     GLOBAL JAVASCRIPT
     ===================================================== -->

<script
    src="{{ url_for(
        'static',
        filename='js/veles.js',
        v='3'
    ) }}"
></script>


<script
    src="{{ url_for(
        'static',
        filename='js/dashboard.js',
        v='2'
    ) }}"
></script>


{% block extra_js %}
{% endblock %}

<script>
    // Power menu toggle
    document.addEventListener('DOMContentLoaded', function() {
        const powerButton = document.getElementById('power-button');
        const powerMenu = document.getElementById('power-menu');

        if (powerButton && powerMenu) {
            powerButton.addEventListener('click', function(e) {
                e.stopPropagation();
                const isOpen = powerMenu.getAttribute('aria-hidden') === 'false';
                powerMenu.setAttribute('aria-hidden', isOpen ? 'true' : 'false');
                powerButton.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
            });

            document.addEventListener('click', function(e) {
                if (!powerButton.contains(e.target) && !powerMenu.contains(e.target)) {
                    powerMenu.setAttribute('aria-hidden', 'true');
                    powerButton.setAttribute('aria-expanded', 'false');
                }
            });
        }
    });
</script>

</body>

</html>
