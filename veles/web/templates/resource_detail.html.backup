{% extends "base.html" %}


{% block extra_css %}

<link rel="stylesheet" href="{{ url_for('static', filename='css/infrastructure.css') }}">

{% endblock %}



{% block title %}

Veles Resource Detail

{% endblock %}




{% block content %}


<div class="infra-page">


<header class="infra-header">

<h1>
🖥 RESOURCE DETAIL
</h1>

<p>
Veles Infrastructure Center
</p>

</header>



<section class="inventory-panel">


{% if resource %}


<div class="server-card">


<div class="server-title">

<h3>

{% if resource.type == "server" %}
🖥
{% elif resource.type == "container" %}
🐳
{% elif resource.type == "agent" %}
🤖
{% elif resource.type == "device" %}
📡
{% else %}
☁
{% endif %}

{{ resource.name }}

</h3>


<span>
🟢 {{ resource.status }}
</span>


</div>



<div class="server-grid">


<div>
<label>ID</label>
<strong>{{ resource.id }}</strong>
</div>


<div>
<label>TYPE</label>
<strong>{{ resource.type }}</strong>
</div>


<div>
<label>HOST</label>
<strong>{{ resource.host or "-" }}</strong>
</div>


<div>
<label>SSH PORT</label>
<strong>{{ resource.port or "-" }}</strong>
</div>


<div>
<label>USERNAME</label>
<strong>{{ resource.username or "-" }}</strong>
</div>


<div>
<label>GROUP</label>
<strong>{{ resource.group or "-" }}</strong>
</div>


<div>
<label>IDENTITY</label>
<strong>{{ resource.identity or "-" }}</strong>
</div>


<div>

<label>
TRUST
</label>

<strong>

{% if resource.trust == "unknown" %}
🟡 UNKNOWN

{% elif resource.trust == "trusted" %}
🟢 TRUSTED

{% else %}
{{ resource.trust }}

{% endif %}

</strong>

</div>



<div>

<label>
VERIFICATION
</label>

<strong>

{% if resource.verification == "never_checked" %}
⚪ NEVER CHECKED

{% elif resource.verification == "checking" %}
🟡 CHECKING

{% elif resource.verification == "verified" %}
🟢 VERIFIED

{% elif resource.verification == "failed" %}
🔴 FAILED

{% else %}
{{ resource.verification }}

{% endif %}

</strong>

</div>



</div>



<section class="infra-actions">


<a href="/infrastructure" class="infra-button">
⬅ BACK
</a>


<button class="infra-button" onclick="openEditModal()">
✏ EDIT
</button>


<button class="infra-button" onclick="openDeleteModal()">
🗑 DELETE
</button>


<a href="/infrastructure/resource/{{ resource.id }}/verify" class="infra-button">
🔍 PING
</a>


<button class="infra-button">
🔎 DISCOVER
</button>


<button class="infra-button">
📊 MONITOR
</button>


<button class="infra-button">
⚙ EXECUTE
</button>


</section>


</div>





<!-- EDIT MODAL -->


<div id="editModal" class="infra-modal" style="display:none;">


<div class="infra-modal-content">


<h2>
✏ EDIT RESOURCE
</h2>


<form method="POST" action="/infrastructure/resource/{{ resource.id }}/edit">


<label>
NAME
</label>

<input 
type="text"
name="name"
value="{{ resource.name }}"
>


<label>
HOST
</label>

<input
type="text"
name="host"
value="{{ resource.host or '' }}"
>


<label>
PORT
</label>

<input
type="text"
name="port"
value="{{ resource.port or '' }}"
>


<label>
USERNAME
</label>

<input
type="text"
name="username"
value="{{ resource.username or '' }}"
>


<div class="infra-actions">


<button type="submit" class="infra-button">
💾 SAVE
</button>


<button type="button" class="infra-button" onclick="closeEditModal()">
❌ CANCEL
</button>


</div>


</form>


</div>


</div>






<!-- DELETE MODAL -->


<div id="deleteModal" class="infra-modal" style="display:none;">


<div class="infra-modal-content">


<h2>
🗑 DELETE RESOURCE
</h2>


<p>
Da li sigurno želiš da obrišeš:
</p>


<strong>
{{ resource.name }}
</strong>



<form method="POST" action="/infrastructure/resource/{{ resource.id }}/delete">


<div class="infra-actions">


<button type="submit" class="infra-button">
🗑 DELETE
</button>


<button type="button" class="infra-button" onclick="closeDeleteModal()">
❌ CANCEL
</button>


</div>


</form>


</div>


</div>





{% else %}


<div class="empty-state">

⚠ Resource nije pronađen.

</div>


{% endif %}


</section>


</div>





<script>

function openEditModal(){

document.getElementById("editModal").style.display="block";

}


function closeEditModal(){

document.getElementById("editModal").style.display="none";

}


function openDeleteModal(){

document.getElementById("deleteModal").style.display="block";

}


function closeDeleteModal(){

document.getElementById("deleteModal").style.display="none";

}

</script>



{% endblock %}