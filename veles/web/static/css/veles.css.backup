:root {

    --bg:#0b0f14;

    --panel:#141b23;

    --panel2:#1a2330;

    --border:#293646;

    --gold:#d9a441;

    --gold2:#ffe9a3;

    --green:#55d66b;

    --muted:#8d9aaa;

    --text:#e8edf2;

}



* {

    box-sizing:border-box;

}



html,
body {

    margin:0;

    padding:0;

    width:100%;

    height:100%;

    background:var(--bg);

    color:var(--text);

    font-family:

        "Segoe UI",
        Arial,
        sans-serif;

}



/*
GLAVNI LAYOUT
*/


.app-layout {

    display:flex;

    width:100%;

    height:100vh;

    overflow:hidden;

}



/*
LEVI MENI
*/


.sidebar {

    width:260px;

    min-width:260px;

    height:100vh;

    background:

        linear-gradient(
            180deg,
            #111820,
            #080c11
        );

    border-right:

        1px solid var(--border);

    padding:25px 15px;

}



.sidebar-brand {

    color:var(--gold);

    font-size:34px;

    font-weight:700;

    letter-spacing:5px;

    text-align:center;

}



.sidebar-subtitle {

    text-align:center;

    color:var(--muted);

    margin-top:8px;

    margin-bottom:35px;

}



/*
NAVIGACIJA
*/


.main-menu {

    display:flex;

    flex-direction:column;

    gap:10px;

}



.main-menu a {

    display:block;

    padding:14px 18px;

    border-radius:10px;

    color:#dce4eb;

    text-decoration:none;

    background:transparent;

    border:

        1px solid transparent;

    transition:.3s;

}



.main-menu a:hover {

    background:var(--panel2);

    border-color:var(--border);

    color:var(--gold);

}



/*
GLAVNI DEO
*/


.main-area {

    flex:1;

    display:flex;

    flex-direction:column;

    min-width:0;

}



/*
GORNJI HEADER
*/


.top-header {

    height:70px;

    background:

        linear-gradient(
            90deg,
            #141b23,
            #10161d
        );

    border-bottom:

        1px solid var(--border);

    display:flex;

    align-items:center;

    justify-content:space-between;

    padding:0 30px;

}



.brand {

    color:var(--gold);

    font-size:22px;

    font-weight:700;

    letter-spacing:3px;

}



.brand-status {

    color:var(--green);

    font-size:14px;

}



/*
SADRZAJ
*/


.page-container {

    flex:1;

    padding:20px;

    overflow:auto;

}



/*
MARKDOWN CHAT
*/


.markdown-body {

    white-space:normal;

    line-height:1.6;

}



.markdown-body p {

    margin-bottom:12px;

}



.markdown-body h1,
.markdown-body h2,
.markdown-body h3 {

    color:var(--gold);

    margin:15px 0 10px;

}



.markdown-body ul,
.markdown-body ol {

    margin-left:25px;

    margin-bottom:15px;

}



.markdown-body code {

    background:#0a0f14;

    color:var(--gold2);

    padding:3px 7px;

    border-radius:6px;

    font-family:

        "JetBrains Mono",
        Consolas,
        monospace;

}



.markdown-body pre {

    background:#05080c;

    border:

        1px solid var(--border);

    border-left:

        4px solid var(--gold);

    border-radius:10px;

    padding:18px;

    margin:15px 0;

    overflow-x:auto;

}



.markdown-body pre code {

    background:none;

    color:#d8f3dc;

    padding:0;

}



.markdown-body blockquote {

    border-left:

        4px solid var(--green);

    padding-left:15px;

    color:var(--muted);

}



/*
SCROLLBAR
*/


::-webkit-scrollbar {

    width:10px;

}


::-webkit-scrollbar-track {

    background:#080b10;

}


::-webkit-scrollbar-thumb {

    background:#303b49;

    border-radius:10px;

}