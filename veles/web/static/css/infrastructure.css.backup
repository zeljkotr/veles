/*
VELES INFRASTRUCTURE CENTER
AI Operations Center UI
*/


.infra-page {

    width:100%;

    display:flex;

    flex-direction:column;

    gap:25px;

}






/*
HEADER
*/


.infra-header {

    text-align:center;

}


.infra-header h1 {

    color:var(--gold);

    letter-spacing:4px;

    font-size:34px;

}


.infra-header p {

    color:var(--muted);

}






.infra-status {


    display:flex;

    justify-content:center;

    flex-wrap:wrap;

    gap:15px;

    margin-top:20px;

}



.infra-status span {


    background:var(--panel);


    border:1px solid var(--border);


    padding:10px 20px;


    border-radius:25px;


    color:var(--text);



    box-shadow:

    0 0 15px rgba(

        217,

        164,

        65,

        .2

    );

}





/*
TOP CARDS
*/


.infra-cards {


    display:grid;


    grid-template-columns:

    repeat(

        3,

        1fr

    );


    gap:20px;


}





.infra-card {


    position:relative;


    overflow:hidden;


    background:

    linear-gradient(

        145deg,

        var(--panel2),

        var(--panel)

    );


    border:

    1px solid var(--border);


    border-radius:18px;


    padding:25px;


    text-align:center;


    transition:.3s;


}



.infra-card:hover {


    transform:

    translateY(-8px);


    border-color:var(--gold);


    box-shadow:


    0 0 35px rgba(

        217,

        164,

        65,

        .35

    );

}



.infra-card::after {


    content:"";


    position:absolute;


    left:0;


    bottom:0;


    width:100%;


    height:3px;


    background:var(--gold);


    animation:

    scan 4s linear infinite;


}



@keyframes scan {


    from {

        transform:

        translateX(-100%);

    }


    to {

        transform:

        translateX(100%);

    }

}





.infra-icon {


    font-size:42px;

}



.infra-card h3 {


    color:var(--muted);

    letter-spacing:2px;

}



.infra-value {


    color:var(--gold);


    font-size:28px;


    font-weight:bold;


    margin:15px 0;


}



.infra-card p {


    color:var(--muted);

}







/*
SYSTEM OVERVIEW
*/


.infra-monitor {


    background:var(--panel);


    border:

    1px solid var(--border);


    border-radius:18px;


    padding:25px;


}



.infra-monitor h2 {


    color:var(--gold);

}




.monitor-grid {


    display:grid;


    grid-template-columns:

    repeat(

        4,

        1fr

    );


    gap:15px;


    margin-top:20px;


}




.monitor-item {


    background:#0b0f14;


    border-radius:12px;


    padding:18px;


}



.monitor-item label {


    display:block;


    color:var(--muted);


    font-size:12px;


    margin-bottom:8px;


}



.monitor-item strong {


    color:var(--text);


}






/*
INVENTORY
*/


.inventory-panel {


    background:var(--panel);


    border:

    1px solid var(--border);


    border-radius:18px;


    padding:25px;


}



.inventory-panel h2 {


    color:var(--gold);


}





.server-card {


    margin-top:20px;


    padding:20px;


    background:


    linear-gradient(

        145deg,

        #1a2330,

        #10161d

    );


    border:

    1px solid var(--border);


    border-radius:14px;


    transition:.3s;


}



.server-card:hover {


    border-color:var(--gold);


    box-shadow:

    0 0 25px rgba(

        217,

        164,

        65,

        .3

    );

}





.server-title {


    display:flex;


    justify-content:space-between;


    align-items:center;


}



.server-title h3 {


    color:white;


}



.server-title span {


    color:var(--green);


    text-shadow:

    0 0 10px var(--green);

}





.server-grid {


    display:grid;


    grid-template-columns:

    repeat(

        4,

        1fr

    );


    gap:15px;


    margin-top:20px;


}




.server-grid div {


    background:#0b0f14;


    padding:15px;


    border-radius:10px;


}



.server-grid label {


    display:block;


    color:var(--muted);


    font-size:12px;


    margin-bottom:5px;


}



.server-grid strong {


    color:var(--text);


}







.empty-state {


    text-align:center;


    padding:40px;


    color:var(--muted);


}







/*
RESPONSIVE
*/


@media(max-width:1100px){


    .infra-cards {


        grid-template-columns:

        1fr;

    }



    .monitor-grid {


        grid-template-columns:

        repeat(

            2,

            1fr

        );

    }



    .server-grid {


        grid-template-columns:

        repeat(

            2,

            1fr

        );

    }


}






@media(max-width:600px){


    .monitor-grid {


        grid-template-columns:

        1fr;


    }



    .server-grid {


        grid-template-columns:

        1fr;


    }


}

/* ADD RESOURCE BUTTON */

.infra-actions {

    margin-top: 20px;

    display: flex;

    justify-content: flex-end;

}



.infra-button {

    display: inline-flex;

    align-items: center;

    gap: 8px;

    padding: 10px 18px;

    background: #141b23;

    border: 1px solid #d9a441;

    border-radius: 8px;

    color: #ffe9a3;

    text-decoration: none;

    font-weight: 600;

    font-size: 14px;

    transition: 0.2s ease;

}



.infra-button:hover {

    background: #1a2330;

    color: #ffffff;

    border-color: #ffe9a3;

}

/* ==============================
   RESOURCE REGISTRY
============================== */


.resource-overview {

    margin-top: 30px;

}



.resource-overview h2 {

    margin-bottom: 20px;

    color: var(--gold2);

}





.resource-grid {

    display: grid;

    grid-template-columns: repeat(
        auto-fit,
        minmax(180px, 1fr)
    );

    gap: 18px;

}





.resource-card {

    background: var(--panel);

    border: 1px solid var(--border);

    border-radius: 12px;

    padding: 20px;

    text-align: center;

    transition: 0.2s ease;

}





.resource-card:hover {

    border-color: var(--gold);

    transform: translateY(-3px);

}





.resource-card h3 {

    margin: 0;

    font-size: 15px;

    color: var(--muted);

}





.resource-number {

    margin-top: 12px;

    font-size: 42px;

    font-weight: 700;

    color: var(--gold);

}





.resource-card::after {

    content: "REGISTERED";

    display: block;

    margin-top: 8px;

    font-size: 11px;

    color: var(--green);

    letter-spacing: 1px;

}

.resource-grid a {

    text-decoration: none;
    color: inherit;
    display: block;

}


.resource-grid a:hover {

    text-decoration: none;

}

.resource-card {
    cursor: pointer;
}

/* ============================= */
/* RESOURCE REGISTRY BOXES        */
/* ============================= */


.resource-list {

    display:grid;

    grid-template-columns:
        repeat(
            auto-fit,
            minmax(300px, 1fr)
        );

    gap:20px;

}



.resource-item {

    display:block;

    width:100%;

    padding:25px;

    box-sizing:border-box;


    background:#141b23;

    border:1px solid #293646;

    border-radius:16px;


    color:inherit;

    text-decoration:none;


}



.resource-item:hover {

    border-color:#d9a441;

    transform:translateY(-3px);

}



.resource-icon {

    float:left;

    width:70px;

    height:70px;

    margin-right:20px;


    display:flex;

    align-items:center;

    justify-content:center;


    font-size:40px;


    background:#0b0f14;

    border-radius:14px;

}



.resource-info {

    overflow:hidden;

}



.resource-info h2 {

    margin-top:0;

    color:#ffe9a3;

}



.resource-info .server-grid {


    display:grid;


    grid-template-columns:
        repeat(3, 1fr);


    gap:15px;


    margin-top:20px;


    clear:both;

}



.resource-arrow {


    text-align:right;

    margin-top:15px;

    font-size:30px;

    color:#d9a441;

    clear:both;

}

/* RESOURCE META GRID */


.resource-meta {

    display:grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap:20px;

    margin-top:20px;

}



.resource-meta div {

    background:#0b0f14;

    padding:12px;

    border-radius:10px;

}



.resource-meta label {

    display:block;

    color:#8d99a8;

    font-size:12px;

    margin-bottom:6px;

}



.resource-meta strong {

    color:#ffffff;

    font-size:14px;

}



@media(max-width:900px){

    .resource-meta {

        grid-template-columns:1fr;

    }

}

